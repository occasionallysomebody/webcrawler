# Next.js analyst UI settings.
# Copy to .env.local for local use; do not commit real secrets.

# Preferred deployment mode: browser calls the same-origin Next proxy at
# /api/crawler, and the proxy attaches CRAWLER_API_TOKEN server-side.
CRAWLER_API_BASE_URL=http://127.0.0.1:8000
CRAWLER_API_TOKEN=replace-with-same-token-as-fastapi
ANALYST_ID=local-analyst

# Optional Basic Auth for the Next UI. Leave blank for local demos.
ANALYST_UI_USERNAME=
ANALYST_UI_PASSWORD=

# Optional direct browser-to-FastAPI mode for unauthenticated local demos only.
# Do not put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_BASE_URL=/api/crawler
NEXT_PUBLIC_ANALYST_ID=local-analyst
