# FastAPI backend deployment settings.
# Copy to .env.local for local use; do not commit real secrets.

# Local development can leave auth disabled.
CRAWLER_ENV=local
CRAWLER_RUN_STORAGE_PATH=outputs/runs
CRAWLER_AUDIT_LOG_PATH=outputs/audit/audit_events.jsonl
CRAWLER_STORAGE_BACKEND=local_jsonl
CRAWLER_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CRAWLER_CORS_ORIGIN_REGEX=

# Set both values for protected API deployments.
CRAWLER_API_TOKEN=replace-with-shared-api-token
CRAWLER_AUTH_REQUIRED=false
